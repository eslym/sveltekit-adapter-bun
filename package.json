{
  "name": "@eslym/sveltekit-adapter-bun",
  "description": "Another sveltekit adapter for bun.",
  "keywords": [
    "sveltekit",
    "adapter",
    "bun"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/eslym/sveltekit-adapter-bun.git"
  },
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    }
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@types/bun": "latest",
    "devalue": "^5.9.2",
    "parse-duration": "^2.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "vite": "^5.0.3 || ^6.0.0 || ^7.0.0-beta.0 || ^8.0.0"
  }
}
